# Copy to packages/hardhat/.env (gitignored). Never commit real keys.

# JSON-RPC relay for --network hederaTestnet (mainnet uses HEDERA_MAINNET_RPC_URL).
HEDERA_RPC_URL=https://testnet.hashio.io/api

# ECDSA private key (0x + 64 hex) of a funded testnet account. Used by `yarn hardhat:deploy` and `yarn hardhat:demo-pay`.
DEPLOYER_PRIVATE_KEY=

# Alternative to DEPLOYER_PRIVATE_KEY: `yarn hardhat:account:generate` stores a password-encrypted key here.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# Operator for `yarn hardhat:create-topic`: account ID (0.0.x) and its ECDSA key. The key becomes the topic's
# submit key, so packages/nextjs/.env.local must use the same pair to write receipts.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
