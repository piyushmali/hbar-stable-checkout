# Copy to packages/nextjs/.env.local (gitignored). Never commit real keys.

# Network the receipt route verifies payments on: testnet (default) or mainnet.
HEDERA_NETWORK=testnet

# HCS topic for receipts, printed by `yarn hardhat:create-topic`.
HCS_TOPIC_ID=

# Server-only operator that signs receipt messages. It must hold the topic's submit key.
# Read only by app/api/receipts; never give these a NEXT_PUBLIC_ prefix.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Optional client settings.
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
